# SimSmile Environment Variables Configuration
# Copy this file to .env and fill in your actual values

# ========================================
# REQUIRED - Supabase Configuration
# ========================================
# Get these from your Supabase project dashboard at https://app.supabase.com
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ========================================
# OPTIONAL - API Configuration
# ========================================
# Timeout for API requests in milliseconds
VITE_API_TIMEOUT=30000

# Number of retry attempts for failed requests
VITE_MAX_RETRY_ATTEMPTS=3

# Image quality threshold (0.0 to 1.0)
VITE_IMAGE_QUALITY_THRESHOLD=0.85

# ========================================
# OPTIONAL - Feature Flags
# ========================================
# Enable Google Analytics tracking
VITE_ENABLE_ANALYTICS=true

# Enable error reporting to external service
VITE_ENABLE_ERROR_REPORTING=true

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true

# ========================================
# OPTIONAL - Security Configuration
# ========================================
# Enable rate limiting for API requests
VITE_ENABLE_RATE_LIMITING=true

# Maximum requests per minute per user
VITE_MAX_REQUESTS_PER_MINUTE=20

# ========================================
# OPTIONAL - External Services
# ========================================
# Sentry DSN for error tracking (if using Sentry)
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics tracking ID (if using GA)
# VITE_GA_TRACKING_ID=G-XXXXXXXXXX

# ========================================
# NOTES:
# ========================================
# 1. Never commit the .env file to version control
# 2. Variables prefixed with VITE_ are exposed to the browser
# 3. Restart the dev server after changing environment variables
# 4. For production deployment, set these in your hosting platform dashboard
#    - Vercel: Project Settings > Environment Variables
#    - Netlify: Site Settings > Build & Deploy > Environment
